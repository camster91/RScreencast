PORT=3000
NODE_ENV=development
PEERJS_DEBUG=false

# Signaling server: "cloud" (PeerJS Cloud, default) or "self" (this server).
# "self" needs a host/proxy that supports WebSockets.
PEER_SERVER=cloud

# Optional TURN relay for networks that block direct connections.
# Recommended: Cloudflare TURN (server creates short-lived credentials).
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Or any TURN server with fixed credentials (also used as fallback).
# Comma-separated URLs, e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
